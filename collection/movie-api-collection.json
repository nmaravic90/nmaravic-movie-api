{
  "info": {
    "name": "Movie Service API",
    "description": "REST API for Movie Service",
    "_postman_id": "movie-service-api-v1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080/api/v1",
      "type": "string"
    },
    {
      "key": "movieId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "reviewId",
      "value": "1",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "MovieRead",
      "description": "Public read operations (search, filter, pagination, rankings)",
      "item": [
        {
          "name": "Get Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["movies"],
              "query": [
                { "key": "query", "value": "Inception", "disabled": true },
                { "key": "genre", "value": "SCI_FI", "disabled": true },
                { "key": "year", "value": "2010", "disabled": true },
                { "key": "minRating", "value": "7.5", "disabled": true },
                { "key": "sort", "value": "title", "disabled": true },
                { "key": "order", "value": "asc", "disabled": true },
                { "key": "page", "value": "0", "disabled": false },
                { "key": "size", "value": "20", "disabled": false }
              ]
            },
            "description": "Returns a paginated list of movies with optional filters and sorting."
          },
          "response": []
        },
        {
          "name": "Get Top Rated Movies",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/top-rated?limit=10",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "top-rated"],
              "query": [
                { "key": "limit", "value": "10", "disabled": false }
              ]
            },
            "description": "Returns a list of movies sorted by average rating, highest first."
          },
          "response": []
        },
        {
          "name": "Get Movie By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}"]
            },
            "description": "Get details for a specific movie by ID."
          },
          "response": []
        }
      ]
    },
    {
      "name": "MovieCrud",
      "description": "Create, update and delete operations (Requires ADMIN role)",
      "item": [
        {
          "name": "Create Movie",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"overview\": \"A thief who steals corporate secrets through dream-sharing technology.\",\n  \"releaseYear\": 2010,\n  \"director\": \"Christopher Nolan\",\n  \"genres\": [\"SCI_FI\", \"THRILLER\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/movies",
              "host": ["{{baseUrl}}"],
              "path": ["movies"]
            },
            "description": "Creates a new movie. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "Replace Movie",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"Inception\",\n  \"overview\": \"A thief who steals corporate secrets through dream-sharing technology.\",\n  \"releaseYear\": 2010,\n  \"director\": \"Christopher Nolan\",\n  \"genres\": [\"SCI_FI\", \"THRILLER\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}"]
            },
            "description": "Full replace - all fields are required. Fields not sent become null. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "Update Movie (Partial)",
          "request": {
            "method": "PATCH",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"overview\": \"Updated overview text.\",\n  \"genres\": [\"SCI_FI\", \"ACTION\"]\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}"]
            },
            "description": "Updates only the fields provided - others remain unchanged. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "Delete Movie",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}"]
            },
            "description": "Deletes the movie and all related data (CASCADE DELETE). Requires ADMIN role."
          },
          "response": []
        }
      ]
    },
    {
      "name": "MovieImage",
      "description": "Movie image management (Requires ADMIN role)",
      "item": [
        {
          "name": "Get Movie Images",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}", "images"]
            },
            "description": "Returns all images for a movie."
          },
          "response": []
        },
        {
          "name": "Upload Movie Image",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "formdata",
              "formdata": [
                {
                  "key": "file",
                  "type": "file",
                  "src": "",
                  "description": "Image file (JPEG, PNG, WebP - max 5MB)"
                },
                {
                  "key": "type",
                  "value": "COVER",
                  "type": "text",
                  "description": "COVER or SLIDE"
                }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}", "images"]
            },
            "description": "Upload an image for a movie. Exactly one COVER image is allowed. Maximum 3 SLIDE images allowed. Requires ADMIN role."
          },
          "response": []
        },
        {
          "name": "Delete All Movie Images",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/images",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}", "images"]
            },
            "description": "Deletes all images for a movie. Requires ADMIN role."
          },
          "response": []
        }
      ]
    },
    {
      "name": "MovieReview",
      "description": "Movie reviews and ratings (Requires USER role)",
      "item": [
        {
          "name": "Get Movie Reviews",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/reviews?page=0&size=20",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}", "reviews"],
              "query": [
                { "key": "page", "value": "0", "disabled": false },
                { "key": "size", "value": "20", "disabled": false }
              ]
            },
            "description": "Returns a paginated list of reviews for a movie."
          },
          "response": []
        },
        {
          "name": "Create Review",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"rating\": 9,\n  \"comment\": \"One of the best movies ever made.\"\n}",
              "options": { "raw": { "language": "json" } }
            },
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/reviews",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}", "reviews"]
            },
            "description": "Adds a review and rating for a movie. One review per user per movie. Requires USER role."
          },
          "response": []
        },
        {
          "name": "Delete Review",
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/movies/{{movieId}}/reviews/{{reviewId}}",
              "host": ["{{baseUrl}}"],
              "path": ["movies", "{{movieId}}", "reviews", "{{reviewId}}"]
            },
            "description": "User can delete their own review. ADMIN can delete any review."
          },
          "response": []
        }
      ]
    }
  ]
}
